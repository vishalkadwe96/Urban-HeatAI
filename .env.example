# Urban Heat AI v2 — Environment Variables
# Copy this to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS (comma-separated allowed origins; use * for dev)
CORS_ORIGINS=*

# Optional: Google Maps API key (not required; project uses CartoDB free tiles)
# GOOGLE_MAPS_API_KEY=

# HeatBot LLM (Groq — free tier, get key at https://console.groq.com/keys)
# Without this key HeatBot automatically falls back to the offline keyword bot.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ── Heat Alerts (vulnerable-population warnings) ──
ALERT_HVI_THRESHOLD=0.65        # HVI >= 0.65 => EXTREME alert (lowered so alerts actually fire outside peak summer)
ALERT_COOLDOWN_MINUTES=60       # per-zone re-alert suppression
ALERT_DEMO_RECIPIENTS=+1-202-555-0100,+1-202-555-0101

# Twilio (optional — free trial: console.twilio.com). Leave blank = mock mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=            # e.g. +12055551234
TWILIO_WHATSAPP_FROM=           # e.g. whatsapp:+14155238886

ALERT_MAX_PER_CHECK=5           # top-N worst zones alerted per scan (rate cap)
ALERT_LANGUAGE=both             # alert SMS language: both | hindi | english

# ── Login: "Continue with Google" (optional) ──
# Create an OAuth 2.0 Web Client ID at https://console.cloud.google.com/apis/credentials
# and add http://localhost:8000 under "Authorized JavaScript origins".
# Leave blank = email/password login still works, Google button shows a setup hint.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
